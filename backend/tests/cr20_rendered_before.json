 "raakmillegem": {
  "alle-sites-cr20": "<main id=\"main\" class=\"site-container py-8\" :inert=\"menu\" data-main>\n    \n    \n\n<div class=\"doc-page\">\n\n\n\n<h1 class=\"text-3xl font-bold text-kop mb-8\">Alle sites</h1>\n\n\n\n\n\n\n<div class=\"prose-raak cms-page\" data-page-body><p><div hx-boost=\"false\" data-tenant-sites>\n  \n  <h3>Firma Twintig</h3>\n  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3 mb-8\">\n    <a href=\"http://testserver/merk-cr20\" data-site-card class=\"block bg-white border border-gray-200 rounded-2xl p-5 !no-underline hover:shadow-md transition-shadow\"><span class=\"block font-semibold !text-ink\">Merk Twintig</span><span class=\"block text-sm text-gray-500 mt-1 break-all\">http://testserver/merk-cr20</span></a>\n  </div>\n  \n  <h3>Raak</h3>\n  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3 mb-8\">\n    <a href=\"http://testserver/raakmillegem\" data-site-card class=\"block bg-white border border-gray-200 rounded-2xl p-5 !no-underline hover:shadow-md transition-shadow\"><span class=\"block font-semibold !text-ink\">Raak Millegem</span><span class=\"block text-sm text-gray-500 mt-1 break-all\">http://testserver/raakmillegem</span></a><a href=\"http://testserver/raakvoorbeeldafdeling\" data-site-card class=\"block bg-white border border-gray-200 rounded-2xl p-5 !no-underline hover:shadow-md transition-shadow\"><span class=\"block font-semibold !text-ink\">Raak Voorbeeldafdeling</span><span class=\"block text-sm text-gray-500 mt-1 break-all\">http://testserver/raakvoorbeeldafdeling</span></a>\n  </div>\n  \n  <h3>Overige</h3>\n  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3 mb-8\">\n    <a href=\"http://testserver/los-cr20\" data-site-card class=\"block bg-white border border-gray-200 rounded-2xl p-5 !no-underline hover:shadow-md transition-shadow\"><span class=\"block font-semibold !text-ink\">Los Twintig</span><span class=\"block text-sm text-gray-500 mt-1 break-all\">http://testserver/los-cr20</span></a>\n  </div>\n  \n</div></p></div>\n\n\n\n</div>\n\n  </main>",
  "circle": "<div id=\"vg-kring\">\n  \n\n\n<div class=\"bg-surface border border-line rounded-2xl p-5\">\n  <h2 class=\"font-semibold text-blue-700\">In de kring</h2>\n  <p class=\"text-sm text-ink-soft mt-0.5\">\n    De kring is breder dan het bestuur: ook vaste deelnemers en de afdelingsondersteuner horen erbij, ook als ze geen lid zijn.\n  </p>\n  \n  <div class=\"mt-3 divide-y divide-line\">\n    \n    <div class=\"py-2.5\">\n      <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1\">\n        <span class=\"font-medium text-sm\">Kring Lid</span>\n        \n        <span class=\"text-sm text-brand-danger\">geen e-mailadres — krijgt de mails niet</span>\n        \n        <form class=\"ml-auto\" hx-post=\"/admin/vergaderingen/kring/1/beeindigen\"\n              hx-target=\"#vg-kring\" hx-swap=\"innerHTML\"\n              data-confirm=\"Kring uit de vergaderkring halen? Oude verslagen blijven ongewijzigd.\">\n          <input type=\"hidden\" name=\"csrf_token\" value=\"…\">\n          <button type=\"submit\" class=\"inline-flex items-center justify-center gap-1.5 font-semibold rounded-lg transition-colors bg-white border border-gray-300 hover:bg-gray-100 text-gray-800 px-3.5 py-2 text-base min-h-11 md:px-3 md:py-1.5 md:text-sm md:min-h-0\" hx-disabled-elt=\"this\" >Uit de kring</button>\n        </form>\n      </div>\n      \n      <form class=\"mt-2 flex flex-wrap items-center gap-2\"\n            hx-post=\"/admin/vergaderingen/kring/1/start\"\n            hx-target=\"#vg-kring\" hx-swap=\"innerHTML\">\n        <input type=\"hidden\" name=\"csrf_token\" value=\"…\">\n        <span class=\"inline-flex items-center gap-2\">\n  <label for=\"vg-start-1\" class=\"text-sm text-ink-soft whitespace-nowrap\">In de kring sinds</label>\n  \n          <input type=\"date\" name=\"start_date\" id=\"vg-start-1\" value=\"2026-01-01\"\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-40\" >\n        \n</span>\n        <button type=\"submit\" class=\"inline-flex items-center justify-center gap-1.5 font-semibold rounded-lg transition-colors bg-white border border-gray-300 hover:bg-gray-100 text-gray-800 px-3.5 py-2 text-base min-h-11 md:px-3 md:py-1.5 md:text-sm md:min-h-0\" hx-disabled-elt=\"this\" >Datum bewaren</button>\n      </form>\n    </div>\n    \n  </div>\n  \n</div>\n\n<div class=\"bg-surface border border-line rounded-2xl p-5 mt-4\">\n  <h2 class=\"font-semibold text-blue-700\">Iemand toevoegen</h2>\n  \n  <div class=\"mt-3\">\n    <span class=\"inline-flex items-center gap-2\">\n  <label for=\"vg-kring-start\" class=\"text-sm text-ink-soft whitespace-nowrap\">In de kring vanaf</label>\n  \n      <input type=\"date\" name=\"start_date\" id=\"vg-kring-start\" value=\"<today>\"\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-40\" >\n    \n</span>\n  </div>\n  \n  <input type=\"search\" name=\"q\" value=\"\" placeholder=\"Zoek op naam…\"\n         class=\"mt-3 w-full sm:w-80 rounded-lg border border-line px-3 py-2 text-sm\"\n         hx-get=\"/admin/vergaderingen/kring\" hx-target=\"#vg-kring-kandidaten\"\n         hx-select=\"#vg-kring-kandidaten\" hx-swap=\"outerHTML\"\n         hx-trigger=\"input changed delay:300ms\" aria-label=\"Zoek een persoon\">\n  <div id=\"vg-kring-kandidaten\">\n  \n  </div>\n</div>\n\n\n<div class=\"bg-surface border border-line rounded-2xl p-5 mt-4\">\n  <h2 class=\"font-semibold text-blue-700\">Iemand toevoegen die geen lid is</h2>\n  <p class=\"text-sm text-ink-soft mt-0.5\">Staat de persoon hierboven niet tussen de zoekresultaten? Dan is hij nog niet gekend — bijvoorbeeld de afdelingsondersteuner. Er wordt een persoon aangemaakt zonder gezin; hij komt meteen in de kring.</p>\n  <form class=\"mt-3 flex flex-wrap items-center gap-2\" hx-post=\"/admin/vergaderingen/kring/nieuw\"\n        hx-target=\"#vg-kring\" hx-swap=\"innerHTML\">\n    <input type=\"hidden\" name=\"csrf_token\" value=\"…\">\n    \n    <input type=\"text\" name=\"first_name\" id=\"first_name\" placeholder=\"Voornaam\" required\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-36\" >\n    <input type=\"text\" name=\"last_name\" id=\"last_name\" placeholder=\"Achternaam\" required\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-40\" >\n    <input type=\"email\" name=\"person_email\" id=\"person_email\" placeholder=\"<example address>\"\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-56\" >\n    <span class=\"inline-flex items-center gap-2\">\n  <label for=\"vg-kring-nieuw-start\" class=\"text-sm text-ink-soft whitespace-nowrap\">vanaf</label>\n  \n      <input type=\"date\" name=\"start_date\" id=\"vg-kring-nieuw-start\" value=\"<today>\"\n       class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-40\" >\n    \n</span>\n    <button type=\"submit\" class=\"inline-flex items-center justify-center gap-1.5 font-semibold rounded-lg transition-colors bg-white border border-gray-300 hover:bg-gray-100 text-gray-800 px-3.5 py-2 text-base min-h-11 md:px-3 md:py-1.5 md:text-sm md:min-h-0\" hx-disabled-elt=\"this\" ><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"inline-block shrink-0 \" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Toevoegen aan de kring</button>\n  </form>\n</div>\n\n\n<div class=\"bg-surface border border-line rounded-2xl p-5 mt-4\">\n  <h2 class=\"font-semibold text-blue-700\">Ondertekening van de mails</h2>\n  <p class=\"text-sm text-ink-soft mt-0.5\">Komt onderaan de agenda- en verslagmail te staan. Je kunt de tekst per mail nog aanpassen voor je verstuurt.</p>\n  <form class=\"mt-3\" hx-post=\"/admin/vergaderingen/kring/ondertekening\"\n        hx-target=\"#vg-kring\" hx-swap=\"innerHTML\">\n    <input type=\"hidden\" name=\"csrf_token\" value=\"…\">\n    <textarea name=\"signature\" id=\"vg-ondertekening\" rows=\"3\" placeholder=\"Met vriendelijke groet,\nVoornaam, Voornaam en Voornaam\"\n          class=\"rounded-lg border border-gray-300 px-3 py-2 text-sm text-ink focus:border-blue-600 focus:ring-2 focus:ring-blue-200 focus:outline-none w-full sm:w-96\"\n          x-data=\"{ bodem: 0,\n              init() { this.groei(); if (this.bodem) return;\n                       const vak = this.$el, zelf = this;\n                       const ro = new ResizeObserver(function () {\n                         if (vak.offsetHeight) { ro.disconnect(); zelf.groei(); } });\n                       ro.observe(vak); },\n              meet() { this.$el.style.height = ``; this.bodem = this.$el.offsetHeight; },\n              groei() { if (!this.bodem) this.meet(); if (!this.bodem) return;\n                        this.$el.style.height = `auto`;\n                        const rand = this.$el.offsetHeight - this.$el.clientHeight;\n                        this.$el.style.height = Math.min(Math.max(this.$el.scrollHeight + rand, this.bodem), 400) + `px`; } }\"\n             x-on:input=\"groei()\" ></textarea>\n    <div class=\"mt-2\"><button type=\"submit\" class=\"inline-flex items-center justify-center gap-1.5 font-semibold rounded-lg transition-colors bg-white border border-gray-300 hover:bg-gray-100 text-gray-800 px-3.5 py-2 text-base min-h-11 md:px-3 md:py-1.5 md:text-sm md:min-h-0\" hx-disabled-elt=\"this\" >Ondertekening bewaren</button></div>\n  </form>\n</div>\n</div>",
  "footer": "<footer class=\"site-footer\" :inert=\"menu\">\n    <div class=\"site-container site-footer-core\">\n    \n      \n      <div class=\"site-footer-row\" data-footer-row>\n        \n        \n        <section data-footer-newsletter>\n          <h2>Nieuwsbrief</h2>\n          \n          <a id=\"nb-voet-link\" href=\"/nieuwsbrief\"\n             class=\"inline-flex items-center justify-center gap-1.5 font-semibold rounded-lg transition-colors bg-[rgb(var(--c-accent))] text-[rgb(var(--c-on-accent))] border border-transparent hover:no-underline hover:shadow-[inset_0_0_0_1px_rgb(var(--c-on-accent))] px-3.5 py-2 text-base min-h-11 md:px-3 md:py-1.5 md:text-sm md:min-h-0 md:h-10 !font-medium\">Aanmelden</a>\n        </section>\n        \n        \n        \n        \n        \n      </div>\n      \n      \n      <p class=\"site-legal\" data-footer-line>© <year> Raak Millegem</p>\n    </div>\n  </footer>",
  "header": "<header class=\"site-header\" :inert=\"menu\">\n    <div class=\"site-container site-header-grid\">\n      \n      <a href=\"/\" class=\"site-brand hover:opacity-90\" data-site-brand>\n        \n        <span class=\"font-brand text-2xl/[1.2] line-clamp-2 md:text-[28px]/[1.2] md:line-clamp-1\" aria-label=\"Raak Millegem\">Raak Millegem</span>\n        \n      </a>\n      \n      <nav id=\"site-nav-breed\" class=\"site-pages\" aria-label=\"Navigatie\">\n        \n<a href=\"/\" class=\"inline-flex items-center min-h-11 px-3 rounded-md text-sm hover:bg-white/10 hover:no-underline text-white/90\">Home</a>\n        \n<a href=\"/fotos\" class=\"inline-flex items-center min-h-11 px-3 rounded-md text-sm hover:bg-white/10 hover:no-underline text-white/90\">Foto&#39;s</a>\n        \n<a href=\"/archief\" class=\"inline-flex items-center min-h-11 px-3 rounded-md text-sm hover:bg-white/10 hover:no-underline text-white/90\">Archief</a>\n        \n        \n      </nav>\n      \n      <div class=\"site-account\" data-site-account>\n        \n        <a href=\"/aanmelden\" data-sign-in class=\"inline-flex items-center gap-2 min-h-11 px-3 rounded-md text-sm hover:bg-white/10 hover:no-underline\">Inloggen</a>\n        \n      </div>\n      \n      <button type=\"button\" x-ref=\"menuButton\" data-menu-button\n              class=\"site-menu-button inline-flex items-center justify-center w-11 h-11 rounded-md hover:bg-white/10\"\n              @click=\"menu = true; $nextTick(() => $refs.menuClose.focus())\" aria-haspopup=\"dialog\"\n              :aria-expanded=\"menu.toString()\" aria-expanded=\"false\" aria-controls=\"site-nav-mobiel\"\n              aria-label=\"Menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"inline-block shrink-0 \" aria-hidden=\"true\"><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"/><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"/><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"/></svg></button>\n    </div>\n  </header>",
  "sites-cr20": "<main id=\"main\" class=\"site-container py-8\" :inert=\"menu\" data-main>\n    \n    \n\n<div class=\"doc-page\">\n\n\n\n<h1 class=\"text-3xl font-bold text-kop mb-8\">Sites</h1>\n\n\n\n\n\n\n<div class=\"prose-raak cms-page\" data-page-body><p><div hx-boost=\"false\" data-tenant-sites>\n  \n  \n  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3 mb-8\">\n    <a href=\"http://testserver/merk-cr20\" data-site-card class=\"block bg-white border border-gray-200 rounded-2xl p-5 !no-underline hover:shadow-md transition-shadow\"><span class=\"block font-semibold !text-ink\">Merk Twintig</span><span class=\"block text-sm text-gray-500 mt-1 break-all\">http://testserver/merk-cr20</span></a>\n  </div>\n  \n</div></p></div>\n\n\n\n</div>\n\n  </main>"
