k-soft\" x-show=\"drop && !chosen\" x-cloak>\n      Wordt verwijderd bij Opslaan. <button type=\"button\" class=\"text-xs font-medium text-link hover:underline whitespace-nowrap\" hx-disabled-elt=\"this\" @click=\"drop = false\">Ongedaan maken</button>\n    </span>\n    <input type=\"hidden\" name=\"drop_poster\" :value=\"drop && !chosen ? '1' : ''\" value=\"\">\n    \n    \n  </div>\n  \n  \n  \n  \n</div>",
