{
 "design_system_edit": "<div data-field=\"kit_poster1\" data-kind=\"upload\" data-span=\"full\" class=\"min-w-0\">\n  \n  \n  <label for=\"kit_poster1\" class=\"block text-sm font-medium leading-[21px] text-ink mb-1\">Affiche</label>\n  \n  \n  <div data-upload class=\"flex flex-wrap items-center gap-3\" x-data=\"{ chosen: '', drop: false }\">\n    <label class=\"relative inline-flex items-center gap-2 min-h-11 md:min-h-10 px-3 rounded-md border border-control-line bg-surface text-sm font-medium text-ink cursor-pointer hover:bg-surface-2 has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-focus\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"inline-block shrink-0 \" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" x2=\"12\" y1=\"3\" y2=\"15\"/></svg><span>Bestand kiezen</span>\n      <input type=\"file\" accept=\"image/*,application/pdf\" class=\"absolute inset-0 h-full w-full opacity-0 cursor-pointer\" @change=\"chosen = $event.target.files.length ? $event.target.files[0].name : ''\" id=\"kit_poster1\" name=\"kit_poster1\" >\n    </label>\n    <span data-upload-chosen class=\"min-w-0 text-[13px] text-ink-soft [overflow-wrap:anywhere]\" x-text=\"chosen\" x-show=\"chosen\" x-cloak></span>\n    \n    <span class=\"flex flex-wrap items-center gap-2 min-w-0\" x-show=\"!chosen && !drop\">\n      <a href=\"/x\" target=\"_blank\" rel=\"noopener\" class=\"text-sm text-blue-500 underline [overflow-wrap:anywhere]\">Huidige bijlage bekijken</a>\n      \n    </span>\n    \n    \n  </div>\n  \n  \n  \n  \n</div>",
 "design_system_read": "<div data-field=\"kit_poster2\" data-kind=\"upload\" data-span=\"full\" class=\"min-w-0\">\n  \n  <p class=\"text-sm font-medium leading-[21px] text-ink mb-1\">Affiche</p>\n  <p data-value class=\"text-sm leading-[21px] min-h-[21px] text-ink whitespace-pre-line [overflow-wrap:anywhere]\"><a href=\"/x\" target=\"_blank\" rel=\"noopener\" class=\"text-blue-500 underline\">Huidige bijlage bekijken</a></p>\n  \n  \n  \n</div>",
