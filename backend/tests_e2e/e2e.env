# The environment of the e2e run — ONE source (#1296).
#
# Read by the CI job `e2e` (.github/workflows/backend-tests.yml, appended to
# $GITHUB_ENV) and by scripts/e2e-local.sh (`docker exec --env-file`). Before
# this file the list stood in both places and they drifted: the local run lacked
# PAYMENT_PROVIDER and went red on what CI showed green.
#
# Only what shapes the app under test belongs here. What differs by place — the
# database URL, the secret, the base URL — stays where it is set, and
# backend/tests/test_e2e_environment_one_source.py holds that line.
#
# Plain NAME=value lines: docker's --env-file does not strip quotes.

# The e2e seed and the stub payment provider are refused outside dev/test.
APP_ENV=dev

# The seed is there, so a flow that finds "no payment/registration" is a FAILURE,
# not a skip (#644). Against HDEV this is unset and skipping stays the behaviour.
E2E_SEEDED=1

# #570: Raakje sits behind this flag; without it the screen renders without an
# input field and the e2e on typing would test nothing. Without MISTRAL_API_KEY
# the bot answers in mock mode, so this costs nothing and calls no one.
CHAT_ENABLED=true

# #788: `native_first`, NOT `provider_only`. The button then chooses per browser:
# without `SpeechRecognition` (the usual state in headless Chromium) it falls back
# to OUR WebSocket, which is the path the dictation e2e tests. A test that fakes
# the Web Speech API (#762) keeps the native path. `mock` transcribes without
# Mistral.
STT_MODE=native_first
STT_PROVIDER=mock

# #870-G: the platform landing appears only on a host from PLATFORM_HOSTS.
# Deliberately a DIFFERENT name than the host the rest of the suite runs on: were
# it that host, every other e2e request would become a platform request. Chromium
# resolves `*.localhost` to loopback itself, so no DNS is needed.
PLATFORM_HOSTS=platform.localhost

# CR-21 (#1887): the browser test of the refused delete runs on a tenant of its
# own (`webshop`, seeded in seed_e2e.py), reached by hostname — back-office
# screens are not reached by a path prefix (`path_for` never prefixes `/admin`).
# Same loopback rule as PLATFORM_HOSTS.
TENANT_HOSTNAMES=webshop.localhost=webshop

# #1075: the dictation e2e also runs on the Raakje overlay of the activities
# screen, which exists only with the admin assistant on (this switch plus the
# tenant switch seed_e2e.py sets). The overlay calls no one.
ADMIN_CHAT_ENABLED=true

# #1274: online payments go to the stub provider, so the e2e walks the whole
# chain (payment page, return, webhook, new state) without Mollie. Allowed
# because APP_ENV is dev; refused on hdev/uat/prod.
PAYMENT_PROVIDER=stub
