#!/usr/bin/env bash
# raakctl — single entry point for managing the environments on the server.
#
#   raakctl                              interactive menu
#   raakctl status [env]                 checkout, version, containers
#   raakctl logs <env> [service] [-n N]  logs of one service (default: backend;
#                                        the menu lists what each env offers)
#   raakctl diagnose <env>               full report -> /tmp/<env>-diagnostics.log
#   raakctl services <env>               which services this env can log
#   raakctl backup <env>                 manual pg_dump -> <checkout>/backups
#   raakctl psql <env> [-c SQL]          database session, READ-ONLY by default
#                                        (-f FILE, --db NAME, --write [--confirm])
#   raakctl up <env>                     start a stopped stack (no build, no git)
#   raakctl stop <env>                   stop a stack, keeping its containers
#   raakctl restart <env> [service]      stop + up in one go (no git, no build)
#   raakctl deploy hdev                  master to HDEV
#   raakctl deploy uat  <tag>            release tag to UAT
#   raakctl deploy prod <tag> --confirm
#   raakctl caddy [ref]                  apply the shared proxy config
#
# Why this exists: the scripts (deploy.sh, logging.sh, deploy-caddy.sh) act on the
# directory they live in, and every environment is a separate checkout of the same
# repository. So `/opt/.../uat/deploy.sh prod` exists and would do the wrong thing.
# raakctl removes that choice: you name an ENVIRONMENT, not a directory and not a
# script.
#
# Directory layout: by default the environments are sibling directories of the
# checkout holding this script (../hdev, ../uat, ../prod, ../caddy). If the server
# is laid out differently, set DEPLOY_HDEV_DIR / DEPLOY_UAT_DIR / DEPLOY_PROD_DIR /
# DEPLOY_CADDY_DIR in the environment on the server. No server paths are
# hard-coded here: this repository is public.
set -euo pipefail

RAAKCTL_ROOT="${RAAKCTL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
ENVIRONMENTS=(hdev uat prod)

die() { echo "raakctl: $*" >&2; exit 1; }

dir_for() {
  case "$1" in
    hdev)  echo "${DEPLOY_HDEV_DIR:-$RAAKCTL_ROOT/hdev}" ;;
    uat)   echo "${DEPLOY_UAT_DIR:-$RAAKCTL_ROOT/uat}" ;;
    prod)  echo "${DEPLOY_PROD_DIR:-$RAAKCTL_ROOT/prod}" ;;
    caddy) echo "${DEPLOY_CADDY_DIR:-$RAAKCTL_ROOT/caddy}" ;;
    *)     die "unknown environment '$1' — pick hdev, uat, prod or caddy" ;;
  esac
}

checkout() {  # validates and echoes the directory
  local d; d="$(dir_for "$1")"
  [ -d "$d/.git" ] || die "no checkout found in $d (set DEPLOY_$(echo "$1" | tr a-z A-Z)_DIR)"
  echo "$d"
}

compose() {  # $1 = env, rest = docker compose arguments
  local env="$1"; shift
  ( cd "$(checkout "$env")" && docker compose -f "docker-compose.$env.yml" --env-file ".env.$env" "$@" )
}

# ── verbs ────────────────────────────────────────────────────────────────────
cmd_status() {
  local envs=("${1:-}"); [ -n "${1:-}" ] || envs=("${ENVIRONMENTS[@]}")
  for env in "${envs[@]}"; do
    local d; d="$(checkout "$env")"
    echo "=== $env ==="
    echo "checkout : $d"
    echo "version  : $(git -C "$d" describe --tags --always 2>/dev/null || echo unknown)"
    compose "$env" ps --format 'table {{.Service}}\t{{.Status}}' 2>/dev/null || echo "(docker compose ps failed)"
    echo
  done
}

services_of() {  # names you can pass to `logs`, for this environment
  compose "$1" config --services 2>/dev/null | sort
  # UAT and PROD have no caddy of their own: they hang off the shared proxy, a
  # separate compose project. Offer it here so `logs <env> caddy` works anyway.
  case "$1" in uat|prod) echo caddy ;; esac
}

cmd_logs() {  # <env> [service] [-n N] — service defaults to backend
  local env="${1:?name an environment: hdev|uat|prod}"; shift || true
  local svc="backend" n=100
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) n="${2:?number of lines after -n}"; shift 2 ;;
      *)  svc="$1"; shift ;;
    esac
  done
  # The shared Caddy serves UAT *and* PROD, so its logs mix both environments.
  if [ "$svc" = caddy ] && { [ "$env" = uat ] || [ "$env" = prod ]; }; then
    echo "(shared Caddy — these logs cover UAT and PROD together)" >&2
    ( cd "$(checkout caddy)" && docker compose -f docker-compose.caddy.yml logs caddy --tail="$n" )
    return
  fi
  compose "$env" logs "$svc" --tail="$n"
}

cmd_services() { services_of "${1:?name an environment: hdev|uat|prod}"; }

# Transitional: raakctl runs from the HDEV checkout (master), but calls scripts
# INSIDE the target checkout — and UAT/PROD still run v1.14.0, where the unified
# scripts do not exist yet (there it is logging-<env>.sh / deploy-<env>.sh).
# Prefer the new name, fall back to the old one. Remove together with #577, once
# v2.0.0 runs everywhere.
run_in_checkout() {  # $1 = env, $2 = new script, $3 = legacy script, rest = args
  local env="$1" new="$2" legacy="$3"; shift 3
  local d; d="$(checkout "$env")"
  if [ -x "$d/$new" ]; then
    ( cd "$d" && "./$new" "$env" "$@" )
  elif [ -x "$d/$legacy" ]; then
    echo "($env still runs a release without $new — using $legacy)" >&2
    ( cd "$d" && "./$legacy" "$@" )
  else
    die "neither $new nor $legacy found in $d"
  fi
}

cmd_diagnose() {
  local env="${1:?name an environment: hdev|uat|prod}"
  run_in_checkout "$env" logging.sh "logging-$env.sh"
}

cmd_backup() {
  # Manual dump, independent of the daily db-backup container. Same shape as the
  # pre-migration backup in deploy.sh: credentials come from the db container
  # itself, never from this script. The prefix deliberately differs from the daily
  # dumps so that db-backup.sh's KEEP_DAYS cleanup does not delete these.
  local env="${1:?name an environment: hdev|uat|prod}"
  case "$env" in hdev|uat|prod) ;; *) die "backup works on hdev, uat or prod — not on '$env'" ;; esac
  local d; d="$(checkout "$env")"
  [ -n "$(compose "$env" ps -q db 2>/dev/null)" ] || die "the db container of $env is not running"

  local dir="$d/backups"; mkdir -p "$dir"
  local out="$dir/handmatig-$env-$(date +%Y%m%d-%H%M%S).sql.gz"
  compose "$env" exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' | gzip > "$out.tmp"

  # A backup you do not check is not a backup: verify the archive is readable and
  # non-empty before calling it valid.
  if ! gzip -t "$out.tmp" 2>/dev/null || [ ! -s "$out.tmp" ]; then
    rm -f "$out.tmp"; die "dump failed or empty — nothing kept"
  fi
  mv "$out.tmp" "$out"
  echo "Backup: $out ($(du -h "$out" | cut -f1), $(gzip -dc "$out" | wc -l) lines of SQL)"
  echo "Copy it off the server with:  scp raak:$out ."
}

cmd_psql() {
  # Database questions, by environment instead of by compose file. During the
  # v2.0.0/v2.1.0 rollout this was the most-needed thing raakctl had no verb for:
  # roughly ten hand-written invocations naming a compose file, an env file, a
  # container and two levels of shell quoting. A forgotten -T gives a puzzling
  # error; a wrong <env> runs your query against the wrong database, and that is
  # the failure with the worst ending.
  #
  # READ-ONLY BY DEFAULT, on every environment. Reading is daily work and must not
  # need a ritual, but a write is not daily work and must not be one keystroke
  # away from a read. The guard is the server's own
  # `default_transaction_read_only`, not a scan of your SQL: a regex over a query
  # is guesswork, while Postgres refusing the write is a fact. It is a guard and
  # not a prison — a superuser session can still turn it off deliberately, which
  # is the point: deliberate, not accidental.
  #
  # --db exists because the stack holds more than one database: umami_<env> was
  # needed repeatedly during the same rollout. Default is the app database, read
  # from the container's own $POSTGRES_DB — credentials never live in this script.
  local env="${1:?name an environment: hdev|uat|prod}"; shift || true
  case "$env" in hdev|uat|prod) ;; *) die "psql works on hdev, uat or prod — not on '$env'" ;; esac

  local write=0 confirmed=0 dbname="" sqlfile="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --write)   write=1 ;;
      --confirm) confirmed=1 ;;
      --db)      dbname="${2:?--db takes a database name}"; shift ;;
      # -f names a file on YOUR side; psql runs inside the container and cannot see
      # it. So it is fed in over stdin instead of passed along — the alternative is
      # a file that "does not exist" while you are looking straight at it.
      -f|--file) sqlfile="${2:?-f takes an SQL file}"; shift ;;
      *)         args+=("$1") ;;
    esac
    shift
  done

  if [ "$write" = 1 ] && [ "$env" = prod ] && [ "$confirmed" != 1 ]; then
    die "writing to the PROD database is not reversible — repeat with --confirm"
  fi
  [ -z "$sqlfile" ] || [ -f "$sqlfile" ] || die "no such SQL file: $sqlfile"
  [ -n "$(compose "$env" ps -q db 2>/dev/null)" ] || die "the db container of $env is not running"

  local opts=(-e "PGOPTIONS=-c default_transaction_read_only=on")
  local mode="read-only (add --write to change data)"
  if [ "$write" = 1 ]; then opts=(-e "PGOPTIONS="); mode="WRITEABLE"; fi
  [ -z "$dbname" ] || opts+=(-e "RAAKCTL_DB=$dbname")

  # ON_ERROR_STOP so a failing statement in an -f script stops instead of running
  # the rest against a half-applied state.
  local inner='exec psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "${RAAKCTL_DB:-$POSTGRES_DB}" "$@"'
  echo "raakctl: $env · ${dbname:-app database} · $mode" >&2

  if [ -n "$sqlfile" ]; then
    compose "$env" exec -T "${opts[@]}" db sh -c "$inner" -- ${args[@]+"${args[@]}"} < "$sqlfile"
  elif [ -t 0 ]; then
    compose "$env" exec "${opts[@]}" db sh -c "$inner" -- ${args[@]+"${args[@]}"}
  else
    compose "$env" exec -T "${opts[@]}" db sh -c "$inner" -- ${args[@]+"${args[@]}"}
  fi
}

cmd_up() {
  # Bring a stopped stack back without touching git or rebuilding images — the
  # recovery counterpart to `stop`. A reboot does not need this: every container
  # runs with `restart: unless-stopped`, so Docker starts them itself. But a
  # container that was explicitly stopped stays stopped across a reboot, and that
  # is exactly when you want one command instead of an improvised compose line.
  local env="${1:?name an environment: hdev|uat|prod}"
  case "$env" in hdev|uat|prod) ;; *) die "up works on hdev, uat or prod — not on '$env'" ;; esac
  compose "$env" up -d
}

cmd_stop() {
  # Stops the containers without removing them, e.g. to free memory during host
  # maintenance. Remember they will NOT come back on their own after a reboot:
  # `unless-stopped` deliberately respects a deliberate stop. Use `up` afterwards.
  local env="${1:?name an environment: hdev|uat|prod}"; shift || true
  case "$env" in hdev|uat|prod) ;; *) die "stop works on hdev, uat or prod — not on '$env'" ;; esac
  if [ "$env" = prod ]; then
    local ok=0; for a in "$@"; do [ "$a" = "--confirm" ] && ok=1; done
    [ "$ok" = 1 ] || die "stopping PROD takes the site down — repeat with --confirm"
  fi
  compose "$env" stop
  echo "$env stopped — it will NOT restart by itself after a reboot. Bring it back with: raakctl up $env"
}

cmd_restart() {
  # Stop followed by up, in one command. Use this to pick up a changed env var.
  #
  # It does NO git, NO build and NO migrations — that is `deploy`, and it exists.
  # Keeping those apart is the whole point: a restart must never change what runs
  # on an environment, only give the same code its new configuration. There is a
  # test on that (backend/tests/test_raakctl_restart.py); it fails if this verb
  # ever grows a build or a git call.
  #
  # Naming one service is allowed and often what you want: changing STT_MODE only
  # concerns the backend, and there is no reason to take the database with it.
  local env="${1:?name an environment: hdev|uat|prod}"; shift || true
  case "$env" in hdev|uat|prod) ;; *) die "restart works on hdev, uat or prod — not on '$env'" ;; esac

  local services=() confirmed=0
  for a in "$@"; do
    case "$a" in --confirm) confirmed=1 ;; *) services+=("$a") ;; esac
  done
  # UAT and PROD serve real visitors: a restart interrupts them, so it asks the
  # same way `deploy` does. HDEV does not — that is where you try things out.
  case "$env" in
    uat|prod) [ "$confirmed" = 1 ] ||
      die "restarting $env interrupts the site — repeat with --confirm" ;;
  esac

  compose "$env" stop ${services[@]+"${services[@]}"}
  compose "$env" up -d ${services[@]+"${services[@]}"}
  echo "$env restarted${services[0]+ (${services[*]})} — no git, no build, no migrations."
  echo "Changing what runs there is a deploy: raakctl deploy $env"
}

cmd_deploy() {
  local env="${1:?name an environment: hdev|uat|prod}"; shift
  # Guardrails first: a missing tag or confirmation must fail before we even look
  # at a checkout.
  local tag="" rest=()
  case "$env" in
    hdev) rest=("$@") ;;
    uat)
      [ $# -ge 1 ] || die "UAT requires a release tag: raakctl deploy uat vX.Y.Z"
      tag="$1"; shift; rest=("$@") ;;
    prod)
      [ $# -ge 1 ] || die "PROD requires a release tag: raakctl deploy prod vX.Y.Z --confirm"
      tag="$1"; shift
      local confirmed=0
      for a in "$@"; do
        if [ "$a" = "--confirm" ]; then confirmed=1; else rest+=("$a"); fi
      done
      [ "$confirmed" = 1 ] || die "a PROD deploy requires --confirm (raakctl deploy prod $tag --confirm)" ;;
    *) die "deploy targets hdev, uat or prod — not '$env'" ;;
  esac
  run_in_checkout "$env" deploy.sh "deploy-$env.sh" ${tag:+"$tag"} ${rest[@]+"${rest[@]}"}
}

cmd_caddy() {
  # The shared proxy serves UAT *and* PROD. deploy-caddy.sh decides which refs to
  # use and validates the config before touching the running container.
  ( cd "$(checkout caddy)" && ./deploy-caddy.sh "$@" )
}

# Snijden op de eerste lege regel en niet op een regelnummer (#753): dat nummer
# schuift zodra er een verb bijkomt, en dan drukt de hulp stilletjes de toelichting
# eronder mee af.
usage() { sed -n '2,/^# Why this exists/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

# ── menu ─────────────────────────────────────────────────────────────────────
# Pick an environment from a numbered list instead of typing it. Bash's `select`
# writes the list to stderr, so the chosen value can be captured on stdout.
pick_env() {
  local options=("$@") choice
  PS3="  environment (number): "
  select choice in "${options[@]}" "cancel"; do
    case "$choice" in
      "")       echo "  invalid choice" >&2 ;;
      cancel)   return 1 ;;
      *)        echo "$choice"; return 0 ;;
    esac
  done
  return 1
}

pick_service() {  # $1 = env
  local options; mapfile -t options < <(services_of "$1")
  [ "${#options[@]}" -gt 0 ] || { echo "  could not list services" >&2; return 1; }
  local choice
  PS3="  service (number): "
  select choice in "${options[@]}" "cancel"; do
    case "$choice" in
      "")     echo "  invalid choice" >&2 ;;
      cancel) return 1 ;;
      *)      echo "$choice"; return 0 ;;
    esac
  done
  return 1
}

menu() {
  while true; do
    echo
    echo "  raakctl — $(hostname)"
    echo "   1) status (all environments)     5) deploy HDEV (master)"
    echo "   2) logs of one service           6) deploy UAT (tag)"
    echo "   3) full diagnostics              7) deploy PROD (tag)"
    echo "   4) apply shared Caddy            8) manual backup"
    echo "   9) database session (read-only)  q) quit"
    echo "  (fetch the report from step 3 onto your laptop with: raak fetch <env>)"
    read -rp "  choice: " k
    case "$k" in
      1) cmd_status ;;
      2) e=$(pick_env "${ENVIRONMENTS[@]}") || continue
         svc=$(pick_service "$e") || continue
         cmd_logs "$e" "$svc" ;;
      3) e=$(pick_env "${ENVIRONMENTS[@]}") || continue
         cmd_diagnose "$e"
         echo "  fetch it onto your laptop:  raak fetch $e" ;;
      4) cmd_caddy ;;
      5) cmd_deploy hdev ;;
      6) read -rp "  tag: " t; cmd_deploy uat "$t" ;;
      7) read -rp "  tag: " t
         echo "  WARNING: this deploys to PRODUCTION."
         read -rp "  type PROD to confirm: " c
         if [ "$c" = "PROD" ]; then cmd_deploy prod "$t" --confirm; else echo "  aborted."; fi ;;
      8) e=$(pick_env "${ENVIRONMENTS[@]}") || continue
         cmd_backup "$e" ;;
      # Read-only on purpose: the menu is for the things you do often, and writing
      # to a database is not one of them. That needs `raakctl psql <env> --write`,
      # typed out.
      9) e=$(pick_env "${ENVIRONMENTS[@]}") || continue
         cmd_psql "$e" ;;
      q|Q) return 0 ;;
      *) echo "  unknown choice" ;;
    esac
  done
}

# ── dispatch ─────────────────────────────────────────────────────────────────
[ $# -eq 0 ] && { menu; exit 0; }
verb="$1"; shift
case "$verb" in
  status)   cmd_status "$@" ;;
  logs)     cmd_logs "$@" ;;
  diagnose) cmd_diagnose "$@" ;;
  services) cmd_services "$@" ;;
  backup)   cmd_backup "$@" ;;
  psql)     cmd_psql "$@" ;;
  up)       cmd_up "$@" ;;
  stop)     cmd_stop "$@" ;;
  restart)  cmd_restart "$@" ;;
  deploy)   cmd_deploy "$@" ;;
  caddy)    cmd_caddy "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command '$verb' (try: raakctl help)" ;;
esac
